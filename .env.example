# Turso
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token
# Auth
AUTH_SECRET=generate-with-openssl-rand-base64-32
# OpenRouter (Plan 3)
OPENROUTER_API_KEY=
OPENROUTER_PROBE_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_SCORE_MODEL=anthropic/claude-opus-4
# Public app URL (used to build the QR join links; falls back to window.location.origin)
NEXT_PUBLIC_APP_URL=https://your-deployed-domain.com

# SendGrid (email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
